rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function own(uid) { return signed() && request.auth.uid == uid; }
  function admin() { return signed() && exists(/databases/$(database)/documents/seminarios_admins/$(request.auth.uid)) && get(/databases/$(database)/documents/seminarios_admins/$(request.auth.uid)).data.active == true; }
  function student() { return signed() && exists(/databases/$(database)/documents/seminarios_students/$(request.auth.uid)) && get(/databases/$(database)/documents/seminarios_students/$(request.auth.uid)).data.active == true; }
  function studentPath(uid) { return /databases/$(database)/documents/seminarios_students/$(uid); }
  function groupPath(g) { return /databases/$(database)/documents/seminarios_groups/$(g); }
  function codePath(code) { return /databases/$(database)/documents/seminarios_codes/$(code); }
  function groupOf(uid) { return get(studentPath(uid)).data.group; }
  function validGroup(g) { return g is int && g >= 1 && g <= 6; }
  function validCode(c) { return c.matches('PSI(00[1-9]|0[1-5][0-9]|060)'); }
  function validMembers(d) { return d.members is map && d.members.keys().size() <= 10 && d.members.values().hasOnly([true]); }
  match /seminarios_admins/{uid} { allow get: if own(uid); allow list, create, update, delete: if false; }
  match /seminarios_codes/{code} {
   allow get, list: if admin();
   allow create: if validCode(code) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid is string && (
    admin() || (signed() && request.resource.data.uid == request.auth.uid && !exists(studentPath(request.auth.uid)) && getAfter(studentPath(request.auth.uid)).data.code == code)
   );
   allow update, delete: if false;
  }
  match /seminarios_students/{uid} {
   allow get: if admin() || own(uid);
   allow list: if admin();
   allow create: if (admin() || own(uid)) && request.resource.data.keys().hasOnly(['uid','name','email','code','group','active'])
    && request.resource.data.keys().hasAll(['uid','name','email','code','group','active'])
    && request.resource.data.uid == uid && request.resource.data.name is string && request.resource.data.name.size() >= 5 && request.resource.data.name.size() <= 120
    && request.resource.data.email is string && request.resource.data.email.size() <= 254
    && (admin() || request.resource.data.email == request.auth.token.email)
    && validCode(request.resource.data.code) && request.resource.data.group == null && request.resource.data.active == true
    && getAfter(codePath(request.resource.data.code)).data.uid == uid;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['group','active'])
    && (request.resource.data.group == null || validGroup(request.resource.data.group))
    && (request.resource.data.group == null || getAfter(groupPath(string(request.resource.data.group))).data.members[uid] == true)
    && (resource.data.group == null || request.resource.data.group == resource.data.group || !getAfter(groupPath(string(resource.data.group))).data.members.keys().hasAny([uid]))
    || own(uid) && resource.data.active == true && resource.data.group == null
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['group'])
    && validGroup(request.resource.data.group)
    && getAfter(groupPath(string(request.resource.data.group))).data.members[uid] == true;
   allow delete: if false;
  }
  match /seminarios_groups/{gid} {
   allow get: if admin() || student();
   allow list: if admin();
   allow create: if admin() && gid.matches('[1-6]') && request.resource.data.keys().hasOnly(['members','caseId']) && request.resource.data.members == {} && request.resource.data.caseId == gid;
   allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && validMembers(request.resource.data) && (
    admin() || (student() && resource.data.members is map
     && request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid])
     && request.resource.data.members.diff(resource.data.members).addedKeys().hasAll([request.auth.uid])
     && request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0
     && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
     && groupOf(request.auth.uid) == null
     && getAfter(studentPath(request.auth.uid)).data.group == int(gid))
   );
   allow delete: if false;
  }
  match /seminarios_cases/{caseId} {
   allow get: if admin() || (student() && validGroup(groupOf(request.auth.uid)) && caseId == string(groupOf(request.auth.uid)));
   allow list: if admin();
   allow create, update, delete: if admin();
   match /stages/{stageId} {
    allow get: if admin() || (student() && caseId == string(groupOf(request.auth.uid)) && (
      stageId == '1' ||
      (stageId == '2' && exists(/databases/$(database)/documents/seminarios_submissions/$(request.auth.uid)/items/checkpoint1)) ||
      (stageId == '3' && exists(/databases/$(database)/documents/seminarios_submissions/$(request.auth.uid)/items/checkpoint2)) ||
      (stageId == '4' && exists(/databases/$(database)/documents/seminarios_submissions/$(request.auth.uid)/items/checkpoint3)) ||
      (stageId == '5' && exists(/databases/$(database)/documents/seminarios_submissions/$(request.auth.uid)/items/checkpoint4))
    ));
    allow list: if admin();
    allow create, update, delete: if admin();
   }
  }
  match /seminarios_submissions/{uid}/items/{itemId} {
   allow get, list: if admin() || (own(uid) && student());
   allow create: if own(uid) && student() && validGroup(groupOf(uid))
    && itemId.matches('checkpoint[1-5]|sintese')
    && request.resource.data.keys().hasOnly(['text','group','createdAt'])
    && request.resource.data.text is string && request.resource.data.text.size() >= 20 && request.resource.data.text.size() <= 12000
    && request.resource.data.group == groupOf(uid) && request.resource.data.createdAt == request.time
    && (itemId == 'checkpoint1'
      || (itemId == 'checkpoint2' && exists(/databases/$(database)/documents/seminarios_submissions/$(uid)/items/checkpoint1))
      || (itemId == 'checkpoint3' && exists(/databases/$(database)/documents/seminarios_submissions/$(uid)/items/checkpoint2))
      || (itemId == 'checkpoint4' && exists(/databases/$(database)/documents/seminarios_submissions/$(uid)/items/checkpoint3))
      || (itemId == 'checkpoint5' && exists(/databases/$(database)/documents/seminarios_submissions/$(uid)/items/checkpoint4))
      || (itemId == 'sintese' && exists(/databases/$(database)/documents/seminarios_submissions/$(uid)/items/checkpoint5)));
   allow update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
